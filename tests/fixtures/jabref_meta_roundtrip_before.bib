% Encoding: UTF-8

@Comment{bibtui-meta: position:before-first-entry;}

@Article{Smith2020,
  author  = {Smith, John},
  title   = {First Paper},
  journal = {Nature},
  year    = {2020},
}

@Comment{bibtui-meta: position:between-entries;}

@Book{Doe2021,
  author    = {Doe, Jane},
  title     = {A Book},
  publisher = {ACM Press},
  year      = {2021},
}

@Comment{bibtui-meta: position:after-last-entry;}

@Comment{bibtui-meta: settings:
  save:
    field_order: alphabetical
    sync_filenames: true
;}

@Comment{jabref-meta: databaseType:bibtex;}

@Comment{jabref-meta: keypattern_article:[auth][year];}

@Comment{jabref-meta: bibtui.save.sync_filenames:true;}

@Comment{jabref-meta: bibtui.save.field_order:alphabetical;}

@Comment{bibtui-meta: position:between-jabref-meta;}

@Comment{jabref-meta: bibtui.citation.style:"IEEEtranN";}

@Comment{jabref-meta: bibtui.field_groups:[{"name":"Identifiers","fields":["isbn","issn"]}];}

@Comment{jabref-meta: bibtui.titlecase.stop_words:["a","an","the"];}

@Comment{jabref-meta: bibtui.test.semicolon:"a\;b";}

@Comment{jabref-meta: bibtui.test.backslash:"C:\\papers\\x";}

@Comment{jabref-meta: bibtui.test.regex:[loc:regex(" [0-9]+", "")];}

% plain user comment at end

@Comment{bibtui-meta: position:end-of-file;}
