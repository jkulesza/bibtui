% Encoding: UTF-8

@Comment{bibtui-meta: position:before-first-entry;}

@Article{Smith2020,
  author  = {Smith, John},
  journal = {Nature},
  title   = {First Paper},
  year    = {2020},
}

@Comment{bibtui-meta: position:between-entries;}

@Book{Doe2021,
  author    = {Doe, Jane},
  publisher = {ACM Press},
  title     = {A Book},
  year      = {2021},
}

@Comment{jabref-meta: bibtui.citation.style:
"IEEEtranN";
}

@Comment{jabref-meta: bibtui.field_groups:
[{"name":"Identifiers","fields":["isbn","issn"]}];
}

@Comment{jabref-meta: bibtui.save.field_order:
alphabetical;
}

@Comment{jabref-meta: bibtui.save.sync_filenames:
true;
}

@Comment{jabref-meta: bibtui.test.backslash:
"C:\papers\x";
}

@Comment{jabref-meta: bibtui.test.regex:
[loc:regex(" [0-9]+", "")];
}

@Comment{jabref-meta: bibtui.test.semicolon:
"a\;b";
}

@Comment{jabref-meta: bibtui.titlecase.stop_words:
["a","an","the"];
}

@Comment{jabref-meta: databaseType:bibtex;}

@Comment{jabref-meta: keypattern_article:[auth][year];}

% plain user comment at end

@Comment{bibtui-meta: position:end-of-file;}
